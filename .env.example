# =============================================================================
# ALUMINI GREEN — variáveis de ambiente
# Copie para `.env` e preencha. Nada aqui é secreto — é só o modelo.
# =============================================================================

# -----------------------------------------------------------------------------
# MODO MOCK
# -----------------------------------------------------------------------------
# true  = login, vídeo e pagamento simulados. Nenhuma API externa é chamada.
#         Use isto para desenvolver e para o cliente testar o sistema inteiro.
# false = usa Clerk, Bunny, Stripe e Mercado Pago de verdade.
#
# Quando as contas estiverem criadas, mude para false e preencha as chaves
# abaixo. Nenhuma linha de código precisa ser alterada.
NEXT_PUBLIC_MOCK_MODE="true"

# -----------------------------------------------------------------------------
# BANCO DE DADOS — Postgres (Railway)
# -----------------------------------------------------------------------------
# Railway > seu projeto > Postgres > Variables > DATABASE_URL
DATABASE_URL="postgresql://usuario:senha@host:5432/railway"

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO — Clerk (só necessário se MOCK_MODE=false)
# -----------------------------------------------------------------------------
# https://dashboard.clerk.com > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ID do usuário professor/admin no Clerk. Quem tiver este ID vê o painel
# do professor. Em modo mock isto é ignorado (o papel vem do banco).
NEXT_PUBLIC_TEACHER_ID=""

# E-mails extras com acesso de professor, além do NEXT_PUBLIC_TEACHER_ID.
# Separados por vírgula. Opcional — deixe vazio se não precisar.
OFFICIAL_ADMIN_EMAILS=""

# -----------------------------------------------------------------------------
# VÍDEO — Bunny Stream (só necessário se MOCK_MODE=false)
# -----------------------------------------------------------------------------
# https://dash.bunny.net > Stream > sua Video Library
BUNNY_STREAM_API_KEY=""
NEXT_PUBLIC_BUNNY_LIBRARY_ID=""
# Hostname da pull zone da library, ex: vz-abc12345.b-cdn.net
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=""

# -----------------------------------------------------------------------------
# PAGAMENTO — Stripe (cartão) — só necessário se MOCK_MODE=false
# -----------------------------------------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Parcelamento máximo no cartão (Stripe Brasil permite até 12)
NEXT_PUBLIC_MAX_INSTALLMENTS="12"

# -----------------------------------------------------------------------------
# PAGAMENTO — Mercado Pago (Pix) — só necessário se MOCK_MODE=false
# -----------------------------------------------------------------------------
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# Liga o Pix na tela de checkout. Deixe false até o Mercado Pago estar ativo.
NEXT_PUBLIC_PIX_ENABLED="false"

# -----------------------------------------------------------------------------
# ARQUIVOS — UploadThing (capas, anexos)
# -----------------------------------------------------------------------------
# https://uploadthing.com/dashboard
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# -----------------------------------------------------------------------------
# E-MAIL — Resend
# -----------------------------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Alumini Green <contato@aluminigreen.org>"

# -----------------------------------------------------------------------------
# DADOS DA EMPRESA (aparecem no recibo e no certificado)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME="Alumini Green"
NEXT_PUBLIC_COMPANY_CNPJ=""
NEXT_PUBLIC_COMPANY_EMAIL="contato@aluminigreen.org"
NEXT_PUBLIC_COMPANY_WHATSAPP="5585991237273"
